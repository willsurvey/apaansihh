# ============================================================
# ENVIRONMENT VARIABLES — Vercel Dashboard
# ============================================================
# Copy file ini, isi nilainya, lalu set di Vercel Dashboard:
# Project → Settings → Environment Variables
# JANGAN commit file .env.local ke repo!
# ============================================================

# GitHub username pemilik repo screener
GITHUB_OWNER=your_github_username

# Nama repo screener (contoh: stock-screener-id)
GITHUB_REPO=your_repo_name

# Nama file workflow GitHub Actions (default: screener.yml)
WORKFLOW_FILE=screener.yml

# GitHub Personal Access Token dengan scope: repo, workflow
# Buat di: github.com → Settings → Developer settings → Personal access tokens
# CATATAN: Gunakan nama GITHUB_TOKEN_WORKFLOW (bukan GITHUB_TOKEN)
# karena GITHUB_TOKEN sudah direservasi oleh Vercel/GitHub
GITHUB_TOKEN_WORKFLOW=ghp_xxxxxxxxxxxxxxxxxxxx

# Secret untuk validasi request ke endpoint /api/cron
# Bisa string random apapun, contoh: openssl rand -hex 32
CRON_SECRET=your_random_secret_string
